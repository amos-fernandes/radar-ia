upstream radar_web { server 127.0.0.1:3000; }
upstream radar_api { server 127.0.0.1:3002; }

server {
  listen 80;
  server_name radaria.com.br www.radaria.com.br;
  location / {
    proxy_pass http://radar_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

server {
  listen 80;
  server_name api.radaria.com.br;
  location / {
    proxy_pass http://radar_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
